rules_version = '2';

// Reglas de Vinilo. Reemplazan el modo de prueba, que vence a los 30 días.
// Leer exige sesión; escribir exige una cuenta de verdad (correo y
// contraseña). Las sesiones anónimas que quedaron de antes solo pueden leer
// hasta que se vinculan a un correo (mismo uid). Cada persona solo escribe
// su perfil, su @usuario, sus notas, sus seguimientos y sus listas; los
// agregados de álbumes los actualiza la misma transacción que guarda la
// nota, así que cualquier cuenta puede tocarlos. Borrar una cuenta lo hace
// la Cloud Function `account` con el Admin SDK, que no pasa por aquí.
// `passwordResets` (los códigos para recuperar la contraseña) no tiene
// regla: solo lo toca la función `recover`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return hasAccount() && request.auth.uid == uid;
    }

    function validName(data) {
      return data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 24
        // Biografía opcional, hasta 160 caracteres.
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160));
    }

    // Minúsculas, de 3 a 20, solo letras, números, punto y guion bajo.
    function validUsername(u) {
      return u is string && u.matches('^[a-z0-9._]{3,20}$');
    }

    // El @usuario del perfil tiene que quedar reservado a nombre de quien
    // escribe, en la misma transacción (getAfter mira el estado final).
    function ownsUsernameAfter(u) {
      return getAfter(/databases/$(database)/documents/usernames/$(u)).data.uid
        == request.auth.uid;
    }

    // Una lista de uids solo cambió en que quien escribe se agregó o se
    // quitó a sí misma (arrayUnion / arrayRemove con su propio uid).
    function onlyToggledSelf(before, after) {
      return before == after
        || (after.size() == before.size() + 1
          && after.hasAll(before)
          && after.removeAll(before) == [request.auth.uid])
        || (before.size() == after.size() + 1
          && before.hasAll(after)
          && before.removeAll(after) == [request.auth.uid]);
    }

    function followDocAfter(follower, followed) {
      return existsAfter(/databases/$(database)/documents/follows/$(follower + '_' + followed));
    }

    function followDocBefore(follower, followed) {
      return exists(/databases/$(database)/documents/follows/$(follower + '_' + followed));
    }

    // Bloqueos: `blocks/{quien}_{aQuien}`.
    function blockExists(blocker, blocked) {
      return exists(/databases/$(database)/documents/blocks/$(blocker + '_' + blocked));
    }

    function blockExistsAfter(blocker, blocked) {
      return existsAfter(/databases/$(database)/documents/blocks/$(blocker + '_' + blocked));
    }

    // Quien revisa los reportes tiene su documento en `admins` (se crea a
    // mano en la consola).
    function isAdmin() {
      return hasAccount()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // `followersCount` de otra persona: igual, o ±1 en la misma transacción
    // en la que creo o borro mi seguimiento hacia ella.
    function followersMoveOk(uid) {
      let before = resource.data.get('followersCount', 0);
      let after = request.resource.data.get('followersCount', 0);
      return after == before
        || (after == before + 1
          && !followDocBefore(request.auth.uid, uid)
          && followDocAfter(request.auth.uid, uid))
        || (after == before - 1
          && followDocBefore(request.auth.uid, uid)
          && !followDocAfter(request.auth.uid, uid));
    }

    // `followingCount` de otra persona: igual, o −1 cuando su seguimiento
    // hacia mí se borra en la misma transacción (al bloquearla).
    function followingMoveOk(uid) {
      let before = resource.data.get('followingCount', 0);
      let after = request.resource.data.get('followingCount', 0);
      return after == before
        || (after == before - 1
          && followDocBefore(uid, request.auth.uid)
          && !followDocAfter(uid, request.auth.uid));
    }

    match /users/{uid} {
      // Un perfil lo lee cualquiera con sesión, menos quien fue bloqueado
      // por su dueña. Listar (buscar personas) no se puede filtrar aquí: lo
      // esconde la app.
      allow get: if signedIn()
        && (request.auth.uid == uid || !blockExists(uid, request.auth.uid));
      allow list: if signedIn();
      allow create: if isOwner(uid)
        && validName(request.resource.data)
        && validUsername(request.resource.data.username)
        && ownsUsernameAfter(request.resource.data.username);
      // La dueña edita su perfil (si el @usuario no cambia no hace falta
      // volver a comprobarlo). Otra persona solo puede mover los contadores
      // en uno, y solo en la misma transacción en la que crea o borra su
      // seguimiento hacia este perfil (`followersCount`) o en la que borra,
      // al bloquear, el seguimiento que venía de este perfil
      // (`followingCount`).
      allow update: if hasAccount() && (
        (request.auth.uid == uid
          && validName(request.resource.data)
          && (
            request.resource.data.get('username', null)
              == resource.data.get('username', null)
            || (validUsername(request.resource.data.username)
              && ownsUsernameAfter(request.resource.data.username))
          ))
        || (request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followersCount', 'followingCount'])
          && followersMoveOk(uid)
          && followingMoveOk(uid))
      );
      allow delete: if false;

      // Lo privado de cada persona: a quién silenció, qué comentarios
      // ocultó y las notas que esperan conexión para guardarse.
      match /mutes/{otherUid} {
        allow read, write: if isOwner(uid);
      }
      match /hidden/{contentId} {
        allow read, write: if isOwner(uid);
      }
      match /outbox/{albumId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRating(request.resource.data);
      }
    }

    // Reserva de cada @usuario: el documento es el nombre, el dato el uid.
    match /usernames/{username} {
      // "✓ Disponible" se revisa en Crear cuenta, antes de que haya sesión:
      // se puede leer uno a la vez sin cuenta, pero listarlos exige sesión.
      allow get: if true;
      allow list: if signedIn();
      allow create: if isOwner(request.resource.data.uid)
        && validUsername(username)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          == username;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    match /albums/{albumId} {
      allow read: if signedIn();
      allow create, update: if hasAccount()
        && request.resource.data.ratingsCount is int
        && request.resource.data.ratingsCount >= 0;
      allow delete: if false;
    }

    function validRating(d) {
      return d.score is int
        && d.score >= 1
        && d.score <= 10
        && d.note is string
        && d.note.size() <= 180;
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if hasAccount()
        && ratingId == request.auth.uid + '_' + request.resource.data.albumId
        && request.resource.data.uid == request.auth.uid
        && validRating(request.resource.data);
      // La dueña edita su nota; cualquier cuenta da o quita su "me gusta" y
      // mueve en uno el contador de respuestas (el mismo lote que crea o
      // borra la respuesta).
      allow update: if hasAccount() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.albumId == resource.data.albumId
          && validRating(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && onlyToggledSelf(resource.data.get('likedBy', []), request.resource.data.likedBy))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repliesCount'])
          && (request.resource.data.repliesCount == resource.data.get('repliesCount', 0) + 1
            || request.resource.data.repliesCount == resource.data.get('repliesCount', 0) - 1))
        // Quien modera puede retirar un comentario reportado (lo deja vacío;
        // la nota y su puntaje se quedan).
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'moderated'])
          && request.resource.data.note == '')
      );
      allow delete: if hasAccount() && resource.data.uid == request.auth.uid;

      // Respuestas (un solo nivel). Se crean a nombre propio sobre una nota
      // que existe, con `ratingUid` = su dueña; no se editan (solo se copia
      // el nombre y la foto nuevos de su autora); las borra su autora, la
      // dueña de la nota o quien modera.
      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if hasAccount()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 280
          && request.resource.data.mentions is list
          && request.resource.data.mentions.size() <= 20
          && request.resource.data.ratingUid
            == get(/databases/$(database)/documents/ratings/$(ratingId)).data.uid
          // Quien fue bloqueado por la dueña de la nota no puede responderle.
          && !blockExists(request.resource.data.ratingUid, request.auth.uid);
        // Su autora solo copia su nombre y su foto nuevos; cualquier cuenta
        // da o quita su "me gusta".
        allow update: if hasAccount() && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && onlyToggledSelf(resource.data.get('likedBy', []), request.resource.data.likedBy))
        );
        allow delete: if hasAccount()
          && (resource.data.uid == request.auth.uid
            || resource.data.ratingUid == request.auth.uid
            || isAdmin());
      }
    }

    // Las respuestas de una persona en todos los hilos (propagar su nombre
    // y su foto): consulta de grupo de colecciones, solo lectura.
    match /{path=**}/replies/{replyId} {
      allow read: if signedIn();
    }

    // Seguimientos: `{follower}_{followed}`. Cada persona crea o borra solo
    // los suyos (donde ella sigue); nadie se sigue a sí misma. Los datos
    // copiados de cada lado los actualiza su propia dueña.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if hasAccount()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followed is string
        && request.resource.data.followed != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followed
        // Con un bloqueo de por medio (en cualquier sentido) no se sigue.
        && !blockExists(request.resource.data.followed, request.auth.uid)
        && !blockExists(request.auth.uid, request.resource.data.followed);
      allow update: if hasAccount()
        && request.resource.data.follower == resource.data.follower
        && request.resource.data.followed == resource.data.followed
        && (
          (resource.data.follower == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerInfo']))
          || (resource.data.followed == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followedInfo']))
        );
      // Lo borra quien sigue; o la persona seguida, pero solo en la misma
      // transacción en la que bloquea a quien la seguía.
      allow delete: if hasAccount()
        && (resource.data.follower == request.auth.uid
          || (resource.data.followed == request.auth.uid
            && blockExistsAfter(request.auth.uid, resource.data.follower)));
    }

    // Bloqueos. Los leen las dos partes (la app de la persona bloqueada
    // también deja de mostrar a quien la bloqueó); solo quien bloquea lo
    // crea y lo quita.
    match /blocks/{blockId} {
      allow read: if signedIn()
        && (resource.data.blocker == request.auth.uid
          || resource.data.blocked == request.auth.uid);
      allow create: if hasAccount()
        && request.resource.data.blocker == request.auth.uid
        && request.resource.data.blocked is string
        && request.resource.data.blocked != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blocked;
      allow update: if false;
      allow delete: if hasAccount() && resource.data.blocker == request.auth.uid;
    }

    // Reportes. Se crean a nombre propio y nunca contra uno mismo; los lee
    // quien los mandó ("Mis reportes") y quien modera, que es el único que
    // los cierra.
    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.reporter == request.auth.uid || isAdmin());
      allow create: if hasAccount()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.targetType in ['user', 'rating', 'reply']
        && request.resource.data.targetId is string
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in
          ['spam', 'harassment', 'hate', 'sexual', 'impersonation', 'violence', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'outcome', 'resolvedBy', 'resolvedAt']);
      allow delete: if false;
    }

    // Quién modera: cada quien puede saber si lo es; nadie lo escribe desde
    // la app.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Avisos de "algo falló" que manda la app desde la pantalla de error.
    match /problems/{problemId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 40
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 500;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // País y géneros de cada artista (los escribe la función `spotify`).
    match /artistMeta/{artistId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Peticiones de discos que faltan ("Pídenos que lo agreguemos").
    match /requests/{requestId} {
      allow create: if hasAccount()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.query is string
        && request.resource.data.query.size() >= 1
        && request.resource.data.query.size() <= 120;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Listas y rankings. Solo quien la creó cambia su contenido; las demás
    // personas solo se agregan o se quitan a sí mismas de `likedBy` y
    // `savedBy`. Los elementos van copiados dentro del documento, con un
    // tope para que quepa en uno solo.
    function validList(d) {
      return d.ownerUid is string
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 60
        && d.description is string
        && d.description.size() <= 300
        && d.kind in ['list', 'ranking']
        && d.itemType in ['tracks', 'albums']
        && d.items is list
        && d.items.size() <= 300
        && d.likedBy is list
        && d.savedBy is list
        // Portada elegida por la autora (Storage lists/{id}/…); null = mosaico.
        && (!('coverUrl' in d) || d.coverUrl == null || d.coverUrl is string)
        && (!('coverPath' in d) || d.coverPath == null || d.coverPath is string);
    }

    match /lists/{listId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.ownerUid)
        && validList(request.resource.data)
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.savedBy.size() == 0;
      allow update: if hasAccount() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && validList(request.resource.data)
          && request.resource.data.likedBy == resource.data.likedBy
          && request.resource.data.savedBy == resource.data.savedBy)
        || (resource.data.ownerUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'savedBy'])
          && onlyToggledSelf(resource.data.likedBy, request.resource.data.likedBy)
          && onlyToggledSelf(resource.data.savedBy, request.resource.data.savedBy))
      );
      allow delete: if hasAccount() && resource.data.ownerUid == request.auth.uid;
    }

    // Notificaciones dentro de la app. Solo se crean a nombre propio
    // (`from` = quien escribe) y nunca para uno mismo; la destinataria las
    // lee y las marca como leídas; quien la provocó puede refrescarla o
    // quitarla (al quitar su "me gusta" o dejar de seguir).
    function validNotification(d) {
      return d.from == request.auth.uid
        && d.to is string
        && d.to != request.auth.uid
        && d.type in ['follow', 'likeRating', 'likeList', 'saveList', 'reply', 'mention']
        && d.read == false
        // A quien te bloqueó no le llegan tus avisos.
        && !blockExists(d.to, request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if hasAccount() && validNotification(request.resource.data);
      allow update: if hasAccount() && (
        (resource.data.to == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (resource.data.from == request.auth.uid
          && validNotification(request.resource.data)
          && request.resource.data.to == resource.data.to)
      );
      // Borrar una que no existe (quitar un "me gusta" cuya notificación ya
      // se borró) no debe tumbar el lote entero.
      allow delete: if hasAccount()
        && (resource == null
          || resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
    }
  }
}

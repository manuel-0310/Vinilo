rules_version = '2';

// Fotos de perfil y de fondo (banner): cada persona (con cuenta de correo y
// contraseña, no una sesión anónima) escribe las suyas, todo el mundo las lee.
service firebase.storage {
  match /b/{bucket}/o {
    function hasAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /avatars/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if hasAccount()
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /banners/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if hasAccount()
        && request.auth.uid == uid
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Fotos de perfil y de fondo (banner): cada persona (con cuenta de correo y
// contraseña, no una sesión anónima) escribe las suyas, todo el mundo las lee.
// Portadas de listas: solo la autora de la lista.
service firebase.storage {
  match /b/{bucket}/o {
    function hasAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Un comodín tiene que ocupar el segmento entero ({uid}.jpg no compila):
    // se compara el nombre del archivo con el uid.
    function isOwnPhoto(fileName) {
      return hasAccount() && fileName == request.auth.uid + '.jpg';
    }

    function validImage(maxBytes) {
      return request.resource == null
        || (request.resource.size < maxBytes
          && request.resource.contentType.matches('image/.*'));
    }

    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwnPhoto(fileName) && validImage(3 * 1024 * 1024);
    }
    match /banners/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwnPhoto(fileName) && validImage(4 * 1024 * 1024);
    }
    // Portada de una lista: solo su autora la sube o la borra (se comprueba
    // leyendo la lista en Firestore). Cada portada tiene su propia ruta.
    match /lists/{listId}/{file} {
      allow read: if request.auth != null;
      allow write: if hasAccount()
        && firestore.get(/databases/(default)/documents/lists/$(listId)).data.ownerUid
          == request.auth.uid
        && validImage(3 * 1024 * 1024);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
